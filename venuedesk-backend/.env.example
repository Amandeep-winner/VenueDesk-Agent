# VenueDesk Control Plane Environment Configuration Template

# Flask Environment and Secrets
FLASK_ENV=production
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
PORT=5001

# PostgreSQL Database Connection
DATABASE_URL=postgresql://venuedesk:venuedesk_dev_password@postgres:5432/venuedesk

# Cryptographic Deployment Salt (shared between backend and authorized endpoints)
DEPLOYMENT_SALT=venuedesk-default-salt-32-chars-long!

# Security & Timing Invariants
CLOCK_SKEW_SECONDS=120
ENROLLMENT_TOKEN_TTL_HOURS=24
DUPLICATE_WINDOW_SECONDS=120

# Feature Flags
ALLOW_UNCLAIMED_ENROLLMENT=false

# Intervals (seconds)
HEARTBEAT_SECONDS=60
TELEMETRY_SECONDS=60
INVENTORY_SECONDS=21600
JOBS_POLL_SECONDS=60
